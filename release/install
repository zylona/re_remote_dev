#!/usr/bin/env bash
set -euo pipefail
pkg_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
version="$(tr -d '[:space:]' < "$pkg_dir/VERSION")"
base="${XDG_DATA_HOME:-$HOME/.local/share}/tssh"
legacy_base="${XDG_DATA_HOME:-$HOME/.local/share}/remote-dev-orchestrator"
target="$base/versions/$version"
python_bin="${PYTHON:-python3}"
if ! command -v "$python_bin" >/dev/null 2>&1; then
  echo "remote-dev-orchestrator requires Python 3 (missing: $python_bin)" >&2
  exit 1
fi
if [ ! -e "$base" ] && [ -d "$legacy_base" ]; then
  mv "$legacy_base" "$base"
fi
mkdir -p "$base/versions"
staging="$(mktemp -d "$base/versions/.${version}.staging.XXXXXX")"
trap 'rm -rf "$staging"' EXIT
cp -a "$pkg_dir/." "$staging/"
if [ -e "$target" ] || [ -L "$target" ]; then
  backup_target="$base/versions/.${version}.previous.$(date +%Y%m%dT%H%M%S).$$"
  mv "$target" "$backup_target"
fi
mv "$staging" "$target"
next_link="$base/.current.$$"
ln -s "$target" "$next_link"
mv -Tf "$next_link" "$base/current"
# A release install is an upgrade, not a side-by-side deployment.  Once the
# new current link is in place, remove older managed payloads so stale Python
# modules and obsolete entrypoints cannot be selected by accident.  Set
# TSSH_KEEP_OLD_VERSIONS=1 when an operator explicitly needs local rollback.
if [ "${TSSH_KEEP_OLD_VERSIONS:-0}" != "1" ]; then
  find "$base/versions" -mindepth 1 -maxdepth 1 ! -path "$target" -exec rm -rf -- {} +
fi
bin_dir="${XDG_BIN_HOME:-$HOME/.local/bin}"
mkdir -p "$bin_dir"
ln -sfn "$base/current/bin/tssh-server" "$bin_dir/tssh-server"
ln -sfn "$base/current/bin/tssh-server" "$bin_dir/remote-dev-orchestrator-server"
ln -sfn "$base/current/bin/remote-dev-ssh-hook" "$bin_dir/remote-dev-ssh-hook"
ln -sfn "$base/current/bin/tssh" "$bin_dir/tssh"
unit_dir="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user"
mkdir -p "$unit_dir"
sed "s#^ExecStart=.*#ExecStart=$base/current/bin/tssh-server#" "$pkg_dir/tssh.service" > "$unit_dir/tssh.service"
cp "$pkg_dir/tssh.socket" "$unit_dir/tssh.socket"
systemctl --user daemon-reload
systemctl --user disable --now remote-dev-orchestrator.socket remote-dev-orchestrator.service 2>/dev/null || true
rm -f "$unit_dir/remote-dev-orchestrator.service" "$unit_dir/remote-dev-orchestrator.socket"
# Migrate units from pre-P3 releases without touching unrelated user units.
shopt -s nullglob
for legacy_unit in "$unit_dir"/remote-dev-master-*.service; do
  systemctl --user disable --now "$(basename "$legacy_unit")" 2>/dev/null || true
  rm -f "$legacy_unit"
done
# Persistent proxy units created by older releases were installed into
# default.target.wants and therefore came back after every login/boot.  The
# current contract is boot-scoped persistence: keep a running unit alive, but
# remove only tssh-managed enablement links so it will not be resurrected
# automatically after reboot.  Do not stop the unit during an upgrade.
session_wants_dir="$unit_dir/default.target.wants"
for session_link in "$session_wants_dir"/tssh-session-*.service; do
  [ -L "$session_link" ] || continue
  session_unit="$(basename "$session_link")"
  systemctl --user disable "$session_unit" 2>/dev/null || true
  rm -f "$session_link"
done
shopt -u nullglob
systemctl --user enable --now tssh.socket
systemctl --user restart tssh.service
PYTHONPATH="$base/current/lib${PYTHONPATH:+:$PYTHONPATH}" "$python_bin" -c 'from remote_dev.ssh_integration import install; print(f"Legacy SSH integration migrated: {install()}")'
echo "tssh $version installed; older managed versions removed (set TSSH_KEEP_OLD_VERSIONS=1 to retain them)"
