[Unit]
Description=tssh local SSH orchestrator
Requires=tssh.socket
After=tssh.socket
StartLimitIntervalSec=600
StartLimitBurst=10

[Service]
Type=simple
ExecStart=tssh-server
KillSignal=SIGTERM
TimeoutStopSec=5
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
PrivateTmp=yes
MemoryMax=128M
TasksMax=32

# 通过 systemd socket activation 启动；不作为 root 服务运行。
