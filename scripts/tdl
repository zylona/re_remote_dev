#!/usr/bin/env bash
set -euo pipefail

# tdl (tmux development launcher) keeps the small, repeatable part of the
# remote development workflow in one command.  It deliberately launches the
# user's official Codex entrypoint (tcodex when installed, otherwise codex)
# instead of replacing or modifying Codex itself.
usage() {
  cat <<'EOF'
用法：tdl codex [Codex 参数...]

在 tmux 的当前会话中打开或切换到三 pane codex 工作窗口：
左上 Neovim、右上 Codex、下方交互式 shell。
环境变量：
  TDL_TMUX_SESSION   可选的目标会话名（默认：当前 tmux 会话）
  TDL_CODEX_COMMAND  Codex 入口（默认优先 tcodex，其次 codex）
EOF
}

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" || $# -eq 0 ]]; then
  usage
  exit 0
fi
if [[ "$1" != "codex" ]]; then
  echo "tdl: 不支持的预设：$1（当前仅支持 codex）" >&2
  exit 2
fi
shift

if [[ -z "${TMUX:-}" ]]; then
  echo "tdl: 请先进入 tmux 窗口后再运行 tdl codex" >&2
  exit 1
fi
if ! command -v tmux >/dev/null 2>&1; then
  echo "tdl: 未找到 tmux，请先安装 tmux" >&2
  exit 1
fi
if [[ -n "${TDL_TMUX_SESSION:-}" ]]; then
  session="$TDL_TMUX_SESSION"
else
  session="$(tmux display-message -p '#{session_name}')"
fi
if [[ -n "${TDL_CODEX_COMMAND:-}" ]]; then
  codex_command=("${TDL_CODEX_COMMAND}")
elif command -v tcodex >/dev/null 2>&1; then
  codex_command=(tcodex)
elif command -v codex >/dev/null 2>&1; then
  codex_command=(codex)
else
  echo "tdl: 未找到 tcodex 或 codex" >&2
  exit 1
fi

current_dir="$PWD"
shell_command="${TDL_SHELL_COMMAND:-${SHELL:-/bin/sh}}"
if command -v nvim >/dev/null 2>&1; then
  nvim_command=(nvim .)
else
  nvim_command=(sh -c 'printf "tdl: 未找到 nvim；请先安装 Neovim。\\n"; exec "${SHELL:-/bin/sh}" -i')
fi

add_layout_panes() {
  local target="$1"
  # First create a full-width bottom shell. Then split the top Codex pane
  # horizontally, leaving Neovim on the left and Codex on the right.
  # Do not assume pane-base-index is zero: users commonly set it to one.
  local codex_pane
  codex_pane="$(tmux list-panes -t "$target" -F '#{pane_id}' | head -n 1)"
  tmux split-window -d -t "$codex_pane" -v -p 25 -c "$current_dir" -- "$shell_command" -i
  tmux split-window -d -b -t "$codex_pane" -h -p 60 -c "$current_dir" -- "${nvim_command[@]}"
}

normalize_layout() {
  local target="$1"
  local codex_pane nvim_pane shell_pane codex_index nvim_index shell_index
  local width height bottom top left right bottom_y layout
  codex_pane="$(tmux list-panes -t "$target" -F '#{pane_id}' | sed -n '1p')"
  nvim_pane="$(tmux list-panes -t "$target" -F '#{pane_id}' | sed -n '2p')"
  shell_pane="$(tmux list-panes -t "$target" -F '#{pane_id}' | sed -n '3p')"
  codex_index="$(tmux display-message -p -t "$codex_pane" '#{pane_index}')"
  nvim_index="$(tmux display-message -p -t "$nvim_pane" '#{pane_index}')"
  shell_index="$(tmux display-message -p -t "$shell_pane" '#{pane_index}')"
  width="$(tmux display-message -p -t "$target" '#{window_width}')"
  height="$(tmux display-message -p -t "$target" '#{window_height}')"
  bottom=$((height * 25 / 100))
  (( bottom < 4 )) && bottom=4
  top=$((height - bottom - 1))
  left=$(((width - 1) * 60 / 100))
  right=$((width - left - 1))
  bottom_y=$((top + 1))
  printf -v layout '{"V":2,"L":{"t":"v","w":%s,"h":%s,"x":0,"y":0,"c":[{"t":"h","w":%s,"h":%s,"x":0,"y":0,"c":[{"t":"p","w":%s,"h":%s,"x":0,"y":0,"i":%s,"I":"%s"},{"t":"p","w":%s,"h":%s,"x":%s,"y":0,"i":%s,"I":"%s"}]},{"t":"p","w":%s,"h":%s,"x":0,"y":%s,"i":%s,"I":"%s"}]}}' \
    "$width" "$height" "$width" "$top" "$left" "$top" "$nvim_index" "$nvim_pane" \
    "$right" "$top" "$((left + 1))" "$codex_index" "$codex_pane" \
    "$width" "$bottom" "$bottom_y" "$shell_index" "$shell_pane"
  tmux select-layout -t "$target" "$layout"
}

if tmux has-session -t "$session" 2>/dev/null; then
  if tmux list-windows -t "$session" -F '#{window_name}' | grep -Fxq codex; then
    target="$session:codex"
    pane_count=$(tmux list-panes -t "$target" | wc -l | tr -d ' ')
    if (( pane_count == 1 )); then
      add_layout_panes "$target"
    elif (( pane_count == 2 )); then
      shell_pane=""
      shell_pane="$(tmux list-panes -t "$target" -F '#{pane_id}' | tail -n 1)"
      tmux split-window -d -t "$shell_pane" -v -p 25 -c "$current_dir" -- "$shell_command" -i
      normalize_layout "$target"
    elif (( pane_count == 3 )); then
      normalize_layout "$target"
    fi
    tmux select-window -t "$session:codex"
  else
    tmux new-window -d -t "$session" -n codex -c "$current_dir" -- "${codex_command[@]}" "$@"
    add_layout_panes "$session:codex"
    tmux select-window -t "$session:codex"
  fi
else
  tmux new-session -d -s "$session" -n codex -c "$current_dir" -- "${codex_command[@]}" "$@"
  add_layout_panes "$session:codex"
fi
