#!/usr/bin/env bash
set -euo pipefail
base="${XDG_DATA_HOME:-$HOME/.local/share}/remote-dev-orchestrator"
python_bin="${PYTHON:-python3}"
if [ -d "$base/current/lib" ] && command -v "$python_bin" >/dev/null 2>&1; then
  PYTHONPATH="$base/current/lib${PYTHONPATH:+:$PYTHONPATH}" "$python_bin" -c 'from remote_dev.ssh_integration import uninstall; print(f"SSH config integration removed: {uninstall()}")' || true
fi
systemctl --user disable --now remote-dev-orchestrator.socket remote-dev-orchestrator.service 2>/dev/null || true
rm -f "${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user/remote-dev-orchestrator.service" "${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user/remote-dev-orchestrator.socket"
rm -f "${XDG_BIN_HOME:-$HOME/.local/bin}/remote-dev-orchestrator-server" "${XDG_BIN_HOME:-$HOME/.local/bin}/remote-dev-ssh-hook"
systemctl --user daemon-reload 2>/dev/null || true
rm -rf "$base"
echo "remote-dev-orchestrator removed"
