#!/usr/bin/env bash
set -euo pipefail
version="${1:-}"
if [[ -z "$version" || ! "$version" =~ ^[0-9]+\.[0-9]+\.[0-9]+([-.][0-9A-Za-z.-]+)?$ ]]; then
  echo "usage: $0 VERSION" >&2
  exit 2
fi
base="${XDG_DATA_HOME:-$HOME/.local/share}/remote-dev-orchestrator"
target="$base/versions/$version"
if [ ! -d "$target" ]; then
  echo "version not installed: $version" >&2
  exit 1
fi
unit_dir="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user"
next_link="$base/.current.rollback.$$"
ln -s "$target" "$next_link"
mv -Tf "$next_link" "$base/current"
sed "s#^ExecStart=.*#ExecStart=$base/current/bin/remote-dev-orchestrator-server#" \
  "$target/remote-dev-orchestrator.service" > "$unit_dir/remote-dev-orchestrator.service"
systemctl --user daemon-reload
systemctl --user enable --now remote-dev-orchestrator.socket
systemctl --user restart remote-dev-orchestrator.service
echo "remote-dev-orchestrator rolled back to $version"
